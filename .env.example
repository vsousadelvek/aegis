# ============================
# Configuracao AEGIS
# ============================
# Copie para .env e ajuste conforme necessario.

# Dispositivo PyTorch (cuda:0, cpu, etc.)
AEGIS_DEVICE=cuda:0

# Modelos YOLO (serao baixados automaticamente se nao existirem localmente)
AEGIS_DET_MODEL=yolov8n.pt
AEGIS_POSE_MODEL=yolov8n-pose.pt

# Limiar de confianca para deteccao
AEGIS_DET_CONF=0.35

# Pular frames (1 = processar todos, 2 = a cada 2 frames, etc.)
AEGIS_FRAME_SKIP=2

# Timeout para objeto abandonado (segundos)
AEGIS_ABANDON_TIMEOUT_S=30

# Timeout para veiculo parado em zona proibida (segundos)
AEGIS_LOITER_TIMEOUT_S=60

# Duracao do buffer circular de clips (segundos)
AEGIS_CLIP_BUFFER_S=10

# Banco de dados
AEGIS_DB_URL=sqlite+aiosqlite:///aegis.db

# Servidor
AEGIS_HOST=0.0.0.0
AEGIS_PORT=8000
